# NicoTracker backend environment example.
#
# Copy this file to `.env` and adjust the values to match your deployment.
# Every variable is optional — defaults live in ``app/config.py``. However, you
# MUST change ``ANIME_QB_PASSWORD`` when ``ANIME_ENV=production`` (the backend
# will refuse to start otherwise, to avoid shipping qBittorrent's factory
# default "adminadmin" into the wild).

# ─── Environment mode ───
# Controls production-only guards. Set to "production" on real servers.
ANIME_ENV=development

# ─── qBittorrent WebUI ───
ANIME_QB_HOST=127.0.0.1
ANIME_QB_PORT=8080
ANIME_QB_USERNAME=admin
ANIME_QB_PASSWORD=please-change-me

# ─── External data sources ───
ANIME_BANGUMI_API_BASE=https://api.bgm.tv
ANIME_NYAA_BASE_URL=https://nyaa.land
ANIME_SUBSPLEASE_RSS=https://subsplease.org/rss/?r=1080
# Mikan (中文字幕组资源聚合) — 国内镜像优先，自动回退到主域名
ANIME_MIKAN_BASE_URL=https://mikanani.me
ANIME_MIKAN_MIRROR_URL=https://mikanani.kas.pub
# AnimeGarden (动漫花园 + moe 开源聚合 JSON API)
ANIME_ANIME_GARDEN_API_BASE=https://api.animes.garden
# Bilibili 番剧 (公开 API，免 Cookie)
ANIME_BILIBILI_API_BASE=https://api.bilibili.com

# ─── Storage paths (relative to the project root unless absolute) ───
ANIME_DOWNLOAD_DIR=data/downloads
ANIME_COVER_CACHE_DIR=data/covers
ANIME_STREAM_CACHE_DIR=data/streams
ANIME_HLS_OUTPUT_DIR=data/streams/hls

# ─── Media tooling ───
ANIME_FFMPEG_BIN=ffmpeg
ANIME_FFPROBE_BIN=ffprobe

# ─── Outbound HTTP proxy (for Nyaa / dmhy / etc. behind GFW) ───
# Example: http://127.0.0.1:7890  or  socks5://127.0.0.1:7891
ANIME_HTTP_PROXY=

# ─── Rate limits (seconds between upstream requests) ───
ANIME_NYAA_RATE_LIMIT=1.0
ANIME_BANGUMI_RATE_LIMIT=0.5
ANIME_MIKAN_RATE_LIMIT=1.0
ANIME_ANIME_GARDEN_RATE_LIMIT=0.5
ANIME_BILIBILI_RATE_LIMIT=0.8
