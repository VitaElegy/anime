# NicoTracker Environment Configuration
# Copy this file to .env and fill in your values

# qBittorrent connection
ANIME_QB_HOST=localhost
ANIME_QB_PORT=8080
ANIME_QB_USERNAME=admin
ANIME_QB_PASSWORD=change_me_please

# Paths
ANIME_DOWNLOAD_DIR=D:/downloads/anime
ANIME_COVER_CACHE_DIR=D:/work/anime/covers

# HTTP proxy for sites blocked by GFW (Nyaa, DMHY, Mikan, etc.)
# ANIME_HTTP_PROXY=http://127.0.0.1:7890

# Rate limiting (seconds between requests)
ANIME_NYAA_RATE_LIMIT=1.0
ANIME_BANGUMI_RATE_LIMIT=0.5
