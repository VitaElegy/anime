ANIME_QB_HOST=127.0.0.1
ANIME_QB_PORT=8080
ANIME_QB_USERNAME=admin
ANIME_QB_PASSWORD=change-me

# Use a path that is valid on the machine running qBittorrent.
# Best practice: deploy NicoTracker backend on the same machine as qBittorrent,
# or make sure both machines use the same mounted path.
ANIME_DOWNLOAD_DIR=/srv/anime/data/downloads
ANIME_COVER_CACHE_DIR=/srv/anime/data/covers

# Optional proxy for Nyaa / other blocked upstreams
# ANIME_HTTP_PROXY=http://127.0.0.1:7890
ANIME_HTTP_PROXY=

ANIME_BANGUMI_API_BASE=https://api.bgm.tv
ANIME_NYAA_BASE_URL=https://nyaa.land
ANIME_SUBSPLEASE_RSS=https://subsplease.org/rss/?r=1080
ANIME_NYAA_RATE_LIMIT=1.0
ANIME_BANGUMI_RATE_LIMIT=0.5
