[Unit]
Description=Anime NicoTracker FastAPI Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/srv/anime/app
EnvironmentFile=/srv/anime/app/.env
ExecStart=/srv/anime/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
